[Unit]
Description=Notebook Dictaphone Transcriber
After=network.target

[Service]
Type=simple
User=deployer
Group=deployer
WorkingDirectory=/opt/apps/notebook
EnvironmentFile=/opt/apps/notebook/.env
ExecStart=/opt/apps/notebook/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 5003
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
