# Copy to .env and replace the values
DATABASE_URL=sqlite+aiosqlite:///app.db
DATA_DIR=data
UPLOAD_MAX_SIZE_MB=500
# Simultaneous processing/TTS jobs (1 keeps ffmpeg and Groq load predictable)
MAX_CONCURRENT_JOBS=1
# How many times a job may be restarted after a crash before it is marked as failed
MAX_JOB_ATTEMPTS=3
# Audio chunks sent to Groq in parallel (raise only if your rate limit allows it)
TRANSCRIPTION_CONCURRENCY=1
TARGET_MP3_KBPS=48
MP3_PASSTHROUGH_KBPS=196
TARGET_CHUNK_MB=22
CHUNK_MAX_MINUTES=40
SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
# How long a sign-in lasts before the cookie expires
SESSION_EXPIRE_DAYS=30

# Users sign in with their own Groq API key (https://console.groq.com/keys).
# Optional server-wide key, used only when a user has no key of their own (local development):
# GROQ_API_KEY=gsk_...
# true — anyone with a valid Groq key can sign in and register;
# false — only keys pre-registered with `python -m app.cli add-user`
ALLOW_SELF_REGISTRATION=true
# Ask the Groq API whether the key is valid on every sign-in
VALIDATE_GROQ_KEY_ON_LOGIN=true
GROQ_VALIDATION_TIMEOUT=10
# Failed sign-in attempts allowed per client IP before the form answers 429
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Behind a reverse proxy (nginx, Caddy) set this to true so the login rate limit
# sees real client addresses. Never enable it when the app is reachable directly.
TRUST_PROXY_HEADERS=false

# For local testing without a real Groq key: MOCK_TRANSCRIPTION=true
MOCK_TRANSCRIPTION=false

# Telegram archive: the audio of finished recordings is uploaded into a private
# channel, so the server does not have to keep every recording forever.
TELEGRAM_ENABLED=false
# Bot token from @BotFather
# TELEGRAM_BOT_TOKEN=123456789:AA...
# Private channel id (negative, starts with -100). Find it with `python -m app.cli tg-discover`
# TELEGRAM_CHAT_ID=-1001234567890
# Bot API endpoint. Point it at a self-hosted local bot api server to lift the 20 MB limit
TELEGRAM_API_BASE=https://api.telegram.org
# Part size for uploads: Telegram returns at most 20 MiB per file, so keep this below that
TELEGRAM_CHUNK_MB=19
# Pause between messages: channels accept roughly 20 messages per minute
TELEGRAM_SEND_INTERVAL_SECONDS=3
TELEGRAM_TIMEOUT=60
TELEGRAM_DOWNLOAD_TIMEOUT=300
TELEGRAM_MAX_RETRIES=3
# Days local files stay after a verified archive: 0 = evict immediately, -1 = never.
# Text lives in SQLite; only the audio is re-downloaded on demand into the cache.
LOCAL_RETENTION_DAYS=7
# Deprecated alias for LOCAL_RETENTION_DAYS; used when the new variable is absent.
# AUDIO_RETENTION_DAYS=14
# Audio pulled back from the channel is cached here, inside DATA_DIR
CACHE_DIR=.cache
CACHE_MAX_MB=2048

# Split long TXT lines through Groq (otherwise local heuristic)
SMART_FORMAT=false
# Groq model for smart formatting
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# Groq Whisper model and prompt (prompt helps the model add punctuation and split paragraphs)
WHISPER_MODEL=whisper-large-v3
WHISPER_PROMPT=Please transcribe with proper punctuation, sentence breaks, and paragraph breaks.

# Noise suppression before transcription (app/services/denoiser.py)
# off | light (stationary noise: hum, hiss, equipment) | deep (adaptive, changing noise)
DENOISE_LEVEL=off
# 0.0-1.0: how much of the estimated noise is removed
DENOISE_STRENGTH=0.8
# Noise threshold sensitivity: higher = more conservative (protects quiet speech)
DENOISE_SENSITIVITY=2.0

# --- Text-to-speech (docs/TTS_SPEC.md) ---
# Show the TTS upload tab
TTS_ENABLED=true
# Active provider: edge (free, default) | openai | grok (paid ones in phase 4)
TTS_PROVIDER=edge
# Провайдеры: edge | openai | grok | azure | google
# OpenAI speech model used when TTS_PROVIDER=openai
TTS_OPENAI_MODEL=gpt-4o-mini-tts
# Default voice as "<provider>:<voice>"
TTS_VOICE=edge:en-US-GuyNeural
TTS_CHUNK_CHARS=1000
TTS_CONCURRENCY=3
TTS_MAX_CHARS=200000
TTS_MAX_FILE_MB=2
TTS_MAX_RETRIES=3
# Pause between provider requests (raise if you hit RPM limits)
TTS_REQUEST_INTERVAL=0
# Local testing without network: sine tones instead of real TTS
MOCK_TTS=false
# Server-side keys for paid providers (phase 4)
# OPENAI_API_KEY=
# XAI_API_KEY=
# Reserve providers (active only when TTS_PROVIDER points at them)
# AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# GOOGLE_TTS_API_KEY=

# --- Translation settings (phrase-by-phrase translation of transcripts) ---
# Show the translation UI on the transcript page
TRANSLATION_ENABLED=true
# Target languages available in the language selector (comma-separated)
TRANSLATION_TARGET_LANGUAGES=en,uk,pt-PT,es
# Default target language when the user opens the transcript page
TRANSLATION_DEFAULT_LANGUAGE=uk
# How many sentences to send in one Groq translation request (legacy cap)
TRANSLATION_BATCH_SIZE=10
# Prefer a character budget per request; keeps prompt sizes stable
TRANSLATION_BATCH_CHARS=3000
# Parallel translation requests (raise only if the Groq rate limit allows it)
TRANSLATION_CONCURRENCY=2
