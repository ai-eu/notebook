# Copy to .env and replace the values
DATABASE_URL=sqlite+aiosqlite:///app.db
DATA_DIR=data
UPLOAD_MAX_SIZE_MB=500
TARGET_MP3_KBPS=48
MP3_PASSTHROUGH_KBPS=196
TARGET_CHUNK_MB=22
CHUNK_MAX_MINUTES=40
SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
# How long a sign-in lasts before the cookie expires
SESSION_EXPIRE_DAYS=30

# Users sign in with their own Groq API key (https://console.groq.com/keys).
# Optional server-wide key, used only when a user has no key of their own (local development):
# GROQ_API_KEY=gsk_...
# true — anyone with a valid Groq key can sign in and register;
# false — only keys pre-registered with `python -m app.cli add-user`
ALLOW_SELF_REGISTRATION=true
# Ask the Groq API whether the key is valid on every sign-in
VALIDATE_GROQ_KEY_ON_LOGIN=true
GROQ_VALIDATION_TIMEOUT=10
# Failed sign-in attempts allowed per client IP before the form answers 429
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Behind a reverse proxy (nginx, Caddy) set this to true so the login rate limit
# sees real client addresses. Never enable it when the app is reachable directly.
TRUST_PROXY_HEADERS=false

# For local testing without a real Groq key: MOCK_TRANSCRIPTION=true
MOCK_TRANSCRIPTION=false

# Telegram archive: the audio of finished recordings is uploaded into a private
# channel, so the server does not have to keep every recording forever.
TELEGRAM_ENABLED=false
# Bot token from @BotFather
# TELEGRAM_BOT_TOKEN=123456789:AA...
# Private channel id (negative, starts with -100). Find it with `python -m app.cli tg-discover`
# TELEGRAM_CHAT_ID=-1001234567890
# Bot API endpoint. Point it at a self-hosted local bot api server to lift the 20 MB limit
TELEGRAM_API_BASE=https://api.telegram.org
# Part size for uploads: Telegram returns at most 20 MiB per file, so keep this below that
TELEGRAM_CHUNK_MB=19
# Pause between messages: channels accept roughly 20 messages per minute
TELEGRAM_SEND_INTERVAL_SECONDS=3
TELEGRAM_TIMEOUT=60
TELEGRAM_DOWNLOAD_TIMEOUT=300
TELEGRAM_MAX_RETRIES=3

# Split long TXT lines through Groq (otherwise local heuristic)
SMART_FORMAT=false
# Groq model for smart formatting
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# Groq Whisper model and prompt (prompt helps the model add punctuation and split paragraphs)
WHISPER_MODEL=whisper-large-v3
WHISPER_PROMPT=Please transcribe with proper punctuation, sentence breaks, and paragraph breaks.
